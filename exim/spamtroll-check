#!/bin/bash
# Spamtroll spam check script for Exim
# Called by Exim ACL to check incoming emails
#
# Usage: spamtroll-check <sender_ip> <sender_email> <from_header> <to_header> <subject> <message_id> <body>
#
# Exit codes:
#   0 = safe (accept email)
#   1 = blocked (reject email)
#   2 = error (accept email - fail open)

CONFIG_FILE="/usr/local/directadmin/plugins/spamtroll/data/spamtroll.conf"
LOG_FILE="/var/log/spamtroll.log"
TIMEOUT=5
MAX_BODY_SIZE=50000  # 50KB limit for body in API call

# Default config values
ENABLED="false"
API_KEY=""
# Base URL only. The /scan/check endpoint is appended at the curl call
# below. Stored value in config file is ignored — the admin panel no
# longer exposes an api_url field.
API_URL="https://api.spamtroll.io/api/v1"
LOG_LEVEL="info"  # debug, info, error
WHITELIST=""
BLACKLIST=""

# Parse command line arguments
SENDER_IP="${1:-}"
SENDER_EMAIL="${2:-}"
FROM_HEADER="${3:-}"
TO_HEADER="${4:-}"
SUBJECT="${5:-}"
MESSAGE_ID="${6:-}"
MESSAGE_BODY="${7:-}"
# Pipe-separated auth bundle — "spf=...|auth=...|dkim=...". Parsed into
# fields for the API payload so legit DKIM/SPF-signed mail can be
# credited with a negative symbol.
AUTH_BUNDLE="${8:-}"

parse_auth_field() {
    # Extract `<key>=...` up to the next `|` separator or end of string.
    local key="$1"
    local val="${AUTH_BUNDLE#*${key}=}"
    # If the bundle didn't contain the key, ${val} == ${AUTH_BUNDLE}; reset.
    [[ "$val" == "$AUTH_BUNDLE" ]] && { echo ""; return; }
    val="${val%%|*}"
    echo "$val"
}

SPF_HEADER=$(parse_auth_field "spf")
AUTH_RESULTS=$(parse_auth_field "auth")
DKIM_SIGNATURE=$(parse_auth_field "dkim")

# Logging function
log() {
    local level="$1"
    local message="$2"

    case "$LOG_LEVEL" in
        debug) ;;
        info)  [[ "$level" == "debug" ]] && return ;;
        error) [[ "$level" != "error" ]] && return ;;
    esac

    echo "$(date '+%Y-%m-%d %H:%M:%S') [$level] $message" >> "$LOG_FILE" 2>/dev/null
}

# Load configuration (safe parsing - no source/eval)
if [[ -f "$CONFIG_FILE" ]]; then
    while IFS='=' read -r key value; do
        # Skip comments and empty lines
        [[ "$key" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$key" ]] && continue
        # Remove quotes and whitespace
        key="${key// /}"
        value="${value#\"}"
        value="${value%\"}"
        value="${value#\'}"
        value="${value%\'}"
        case "$key" in
            ENABLED)   ENABLED="$value" ;;
            API_KEY)   API_KEY="$value" ;;
            API_URL)   API_URL="$value" ;;
            LOG_LEVEL) LOG_LEVEL="$value" ;;
            TIMEOUT)   TIMEOUT="$value" ;;
            WHITELIST) WHITELIST="$value" ;;
            BLACKLIST) BLACKLIST="$value" ;;
        esac
    done < "$CONFIG_FILE"
fi

# Check if plugin is enabled
if [[ "$ENABLED" != "true" ]] || [[ -z "$API_KEY" ]]; then
    exit 0  # Not configured, allow email
fi

# Check whitelist (has priority — fail-open)
if [[ -n "$WHITELIST" && -n "$SENDER_EMAIL" ]]; then
    SENDER_DOMAIN="${SENDER_EMAIL##*@}"
    IFS=',' read -ra WL_ENTRIES <<< "$WHITELIST"
    for entry in "${WL_ENTRIES[@]}"; do
        entry="${entry## }"
        entry="${entry%% }"
        [[ -z "$entry" ]] && continue
        if [[ "${SENDER_EMAIL,,}" == "${entry,,}" ]] || [[ "${SENDER_DOMAIN,,}" == "${entry,,}" ]] || [[ "@${SENDER_DOMAIN,,}" == "${entry,,}" ]]; then
            log "info" "from=${SENDER_EMAIL} ip=${SENDER_IP} status=safe reason=whitelist match=${entry}"
            exit 0
        fi
    done
fi

# Check blacklist
if [[ -n "$BLACKLIST" && -n "$SENDER_EMAIL" ]]; then
    SENDER_DOMAIN="${SENDER_DOMAIN:-${SENDER_EMAIL##*@}}"
    IFS=',' read -ra BL_ENTRIES <<< "$BLACKLIST"
    for entry in "${BL_ENTRIES[@]}"; do
        entry="${entry## }"
        entry="${entry%% }"
        [[ -z "$entry" ]] && continue
        if [[ "${SENDER_EMAIL,,}" == "${entry,,}" ]] || [[ "${SENDER_DOMAIN,,}" == "${entry,,}" ]] || [[ "@${SENDER_DOMAIN,,}" == "${entry,,}" ]]; then
            log "info" "from=${SENDER_EMAIL} ip=${SENDER_IP} status=blocked reason=blacklist match=${entry}"
            exit 1
        fi
    done
fi

# Truncate body if too large
if [[ ${#MESSAGE_BODY} -gt $MAX_BODY_SIZE ]]; then
    MESSAGE_BODY="${MESSAGE_BODY:0:$MAX_BODY_SIZE}"
    log "debug" "Body truncated to $MAX_BODY_SIZE bytes"
fi

# Build content for classification (subject + body)
CONTENT="Subject: ${SUBJECT}

${MESSAGE_BODY}"

log "debug" "Checking email from=${SENDER_EMAIL} ip=${SENDER_IP} subject=\"${SUBJECT:0:50}\""

# Build JSON payload using jq for proper escaping
PAYLOAD=$(jq -n \
    --arg content "$CONTENT" \
    --arg source "email" \
    --arg ip "$SENDER_IP" \
    --arg email "$SENDER_EMAIL" \
    --arg from "$FROM_HEADER" \
    --arg to "$TO_HEADER" \
    --arg subject "$SUBJECT" \
    --arg message_id "$MESSAGE_ID" \
    --arg spf "$SPF_HEADER" \
    --arg auth_results "$AUTH_RESULTS" \
    --arg dkim "$DKIM_SIGNATURE" \
    '{
        content: $content,
        source: $source,
        ip_address: $ip,
        email: $email,
        headers: {
            from: $from,
            to: $to,
            subject: $subject,
            message_id: $message_id,
            "received-spf": $spf,
            "authentication-results": $auth_results,
            "dkim-signature": $dkim
        }
    }' 2>/dev/null)

if [[ -z "$PAYLOAD" ]]; then
    log "error" "Failed to build JSON payload"
    exit 0  # Fail open
fi

# Call API — append /scan/check to the base URL.
# -w "\n%{http_code}" appends the status code on its own line so we
# can detect HTTP 402 (QUOTA_EXCEEDED) without parsing the body —
# the backend may send an empty / malformed body in pathological
# cases and we still need to fail-open cleanly.
HTTP_RESPONSE=$(curl -s -m "$TIMEOUT" -w "\n%{http_code}" \
    -H "Content-Type: application/json" \
    -H "X-API-Key: $API_KEY" \
    -d "$PAYLOAD" \
    "${API_URL%/}/scan/check" 2>/dev/null)

CURL_EXIT=$?
if [[ $CURL_EXIT -ne 0 ]]; then
    log "error" "API call failed: curl exit=$CURL_EXIT"
    exit 0  # Fail open
fi

HTTP_CODE=$(echo "$HTTP_RESPONSE" | tail -n1)
RESPONSE=$(echo "$HTTP_RESPONSE" | sed '$d')

# Quota exhausted — record one line in our skipped log and let the
# message through. The user's plan ran out of daily scans, blocking
# legitimate mail because of a billing condition is the wrong call.
# The log file is rotated by the spamtroll-logrotate script that
# ships with this plugin; the DA admin module reads it for the
# "X messages skipped — upgrade your plan" notice.
if [[ "$HTTP_CODE" == "402" ]]; then
    USAGE=$(echo "$RESPONSE" | jq -c '.error.usage // {}' 2>/dev/null)
    log "warn" "quota_exceeded from=${SENDER_EMAIL} to=\"${TO_HEADER}\" usage=${USAGE}"
    SKIP_LOG="${LOG_DIR:-/var/log/spamtroll}/quota_skipped.log"
    mkdir -p "$(dirname "$SKIP_LOG")" 2>/dev/null
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ${SENDER_EMAIL} ${USAGE}" >> "$SKIP_LOG" 2>/dev/null
    exit 0  # Fail open — accept the message without scanning
fi

# Parse response. Backend wraps successful replies as
#   {"success": true, "data": {"status": "...", "spam_score": N, ...}}
# so we unwrap .data.*. Fall back to top-level keys only to stay
# compatible with older API shapes.
STATUS=$(echo "$RESPONSE" | jq -r '.data.status // .status // "safe"' 2>/dev/null)
SCORE=$(echo "$RESPONSE" | jq -r '.data.spam_score // .spam_score // 0' 2>/dev/null)

# Handle empty/null values
[[ -z "$STATUS" || "$STATUS" == "null" ]] && STATUS="safe"
[[ -z "$SCORE" || "$SCORE" == "null" ]] && SCORE="0"

# Log result
# Strip any whitespace/newlines from TO and SUBJECT headers — Exim
# may pass multi-line or folded header values.
TO_CLEAN=$(echo -n "$TO_HEADER" | tr -d '\n\r' | head -c 200)
SUBJECT_CLEAN=$(echo -n "$SUBJECT" | tr -d '\n\r' | head -c 200)

log "info" "from=${SENDER_EMAIL} to=\"${TO_CLEAN}\" subject=\"${SUBJECT_CLEAN}\" ip=${SENDER_IP} status=${STATUS} score=${SCORE}"

# Return based on status
if [[ "$STATUS" == "blocked" ]]; then
    exit 1  # Reject email
fi

exit 0  # Accept email
